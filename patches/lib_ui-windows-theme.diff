 base::flat_set<IconData*> iconData;
 
+constexpr auto kIconScale = 1.1;
+
+[[nodiscard]] QImage ScaleIconImage(QImage image) {
+	if (image.isNull()) {
+		return image;
+	}
+	const auto target = QSize(
+		qRound(image.width() * kIconScale),
+		qRound(image.height() * kIconScale));
+	auto result = image.scaled(
+		target,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	result.setDevicePixelRatio(image.devicePixelRatio());
+	return result;
+}
+
+
 [[nodiscard]] QImage CreateIconMask(
 		not_null<const IconMask*> mask,
 		int scale,
@@ -379,9 +397,11 @@ void MonoIcon::ensureLoaded() const {
 
 	_size = readGeneratedSize(_mask, Scale());
 	if (!_size.isEmpty()) {
-		_size = _size.grownBy(_padding);
+		_size = QSize(
+			qRound(_size.width() * kIconScale),
+			qRound(_size.height() * kIconScale)).grownBy(_padding);
 	} else {
-		_maskImage = ResolveIconMask(_mask);
+		_maskImage = ScaleIconImage(ResolveIconMask(_mask));
 		createCachedPixmap();
 	}
 }
